##
## Treiber für den Surface Laptop 7 (Quellen: airootfs/usr/share/surface/kmods)
## Drivers for the Surface Laptop 7 (sources: airootfs/usr/share/surface/kmods)
##

# Touchpad/Touchscreen: QSPI-Modus des GENI-SPI-Controllers, GPI-DMA mit
# QSPI-Protokoll, HID-over-SPI
CONFIG_QCOM_GPI_DMA=m
CONFIG_SPI_QCOM_GENI_QSPI=m
CONFIG_SPI_HID=m

# Tastaturbeleuchtung als LED surface::kbd_backlight
CONFIG_HID_SURFACE_KBD_BACKLIGHT=m

# WLAN (ath12k mit dem rfkill-Patch)
CONFIG_ATH12K=m

# Firmware: Arch Linux liefert sie zstd-komprimiert, die Arch-Linux-ARM-
# Konfiguration lädt nur xz (bis dahin hilft surface-firmware-xz)
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# zram mit zstd/lz4 (zram-generator.conf); die Arch-Linux-ARM-Konfiguration
# kennt nur lzo
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

##
## Bau / build
##

# Ohne GCC-Plugins: Ein per Cross-Compiler gebauter Kernel brächte Plugins für
# den falschen Compiler mit; aktiviert ist in der Arch-Linux-ARM-Konfiguration
# ohnehin keines.
# CONFIG_GCC_PLUGINS is not set
