#!/bin/bash
# Installiert Arch Linux ARM mit linux-surface-Kernel in ein vorbereitetes,
# eingehängtes Zielverzeichnis.
#
# Partitionieren, Formatieren und Einhängen bleibt bewusst Handarbeit (wie bei
# der normalen Arch-Installation) – dieses Skript fasst nichts an, was nicht
# unter dem Zielverzeichnis eingehängt ist.
set -euo pipefail

# shellcheck source=../../share/surface/i18n.sh
source /usr/share/surface/i18n.sh

usage() {
    if [[ "$SURFACE_LANG" == en ]]; then
        cat <<'USAGE'
Installs Arch Linux ARM with the linux-surface kernel into a prepared, mounted
target directory. Partitioning, formatting and mounting are left to you (as in
a regular Arch installation). Example:

  mount /dev/nvme0n1p5 /mnt                 # root partition (ext4/btrfs/...)
  mount --mkdir /dev/nvme0n1p1 /mnt/efi     # existing EFI system partition
  surface-install /mnt

Usage:
  surface-install [options] [TARGET]        (TARGET defaults to /mnt)

  --device ID       force a device instead of detecting it (surface-device --list)
  --esp PATH        mount point of the EFI system partition (default: detect
                    TARGET/efi, TARGET/boot/efi or TARGET/boot)
  --hostname NAME   host name (default: surface)
  --packages "..."  additional packages
  --no-firmware     do not take firmware from Windows
  --no-bootloader   do not install GRUB (only write the configuration)
  --no-passwd       do not ask for a root password
USAGE
    else
        cat <<'USAGE'
Installiert Arch Linux ARM mit linux-surface-Kernel in ein vorbereitetes,
eingehängtes Zielverzeichnis. Partitionieren, Formatieren und Einhängen bleibt
Handarbeit (wie bei der normalen Arch-Installation). Beispiel:

  mount /dev/nvme0n1p5 /mnt                 # Root-Partition (ext4/btrfs/...)
  mount --mkdir /dev/nvme0n1p1 /mnt/efi     # vorhandene EFI-Systempartition
  surface-install /mnt

Aufruf:
  surface-install [Optionen] [ZIEL]         (ZIEL ist standardmäßig /mnt)

  --device ID       Gerät vorgeben statt erkennen (siehe: surface-device --list)
  --esp PFAD        Einhängepunkt der EFI-Systempartition (sonst automatisch:
                    ZIEL/efi, ZIEL/boot/efi oder ZIEL/boot)
  --hostname NAME   Rechnername (Standard: surface)
  --packages "..."  zusätzliche Pakete
  --no-firmware     keine Firmware aus Windows übernehmen
  --no-bootloader   GRUB nicht installieren (nur Konfiguration schreiben)
  --no-passwd       kein root-Passwort abfragen
USAGE
    fi
}

SHARE=/usr/share/surface
target=/mnt
device=""
esp=""
hostname="surface"
extra_pkgs=()
do_firmware=1
do_bootloader=1
do_passwd=1

msg()  { printf '\n\033[1;32m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m %s\n' "$(t 'WARNUNG:' 'WARNING:')" "$*" >&2; }
die()  { printf '\033[1;31m%s\033[0m %s\n' "$(t 'FEHLER:' 'ERROR:')" "$*" >&2; exit 1; }
ask()  { # frage -> 0 bei ja
    local a
    read -r -p "$1 $(t '[j/N]' '[y/N]') " a
    [[ "$a" =~ ^[jJyY] ]]
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --device)        device="$2"; shift ;;
        --esp)           esp="$2"; shift ;;
        --hostname)      hostname="$2"; shift ;;
        --packages)      read -r -a extra_pkgs <<< "$2"; shift ;;
        --no-firmware)   do_firmware=0 ;;
        --no-bootloader) do_bootloader=0 ;;
        --no-passwd)     do_passwd=0 ;;
        -h|--help)       usage; exit 0 ;;
        -*)              die "$(t 'Unbekannte Option' 'Unknown option'): $1" ;;
        *)               target="${1%/}" ;;
    esac
    shift
done

(( EUID == 0 )) || die "$(t 'Bitte als root ausführen.' 'Please run as root.')"
mountpoint -q "$target" || die "$target: $(t 'kein Einhängepunkt. Erst die Root-Partition dort einhängen.' \
                                             'not a mount point. Mount the root partition there first.')"

# --- EFI-Systempartition -----------------------------------------------------
if [[ -z "$esp" ]]; then
    for c in "$target/efi" "$target/boot/efi" "$target/boot"; do
        if mountpoint -q "$c" && [[ "$(findmnt -no FSTYPE "$c")" == vfat ]]; then
            esp="$c"
            break
        fi
    done
fi
if (( do_bootloader )); then
    [[ -n "$esp" ]] || die "$(t "Keine EFI-Systempartition gefunden. Bitte unter $target/efi einhängen (oder --esp angeben)." \
                                "No EFI system partition found. Mount it at $target/efi (or pass --esp).")"
    mountpoint -q "$esp" || die "$esp: $(t 'nicht eingehängt.' 'not mounted.')"
    [[ "$esp" == "$target"/* ]] || die "$(t "Die EFI-Systempartition muss unterhalb von $target eingehängt sein." \
                                            "The EFI system partition has to be mounted below $target.")"
fi
esp_in_target="${esp#"$target"}"

# --- Gerät -------------------------------------------------------------------
if [[ -z "$device" ]]; then
    device="$(surface-device --id || true)"
fi
dtb=""
dev_args=""
if [[ -n "$device" ]]; then
    dtb="$(surface-device --lookup "$device" --dtb)" \
        || die "$(t 'Unbekanntes Gerät' 'Unknown device') '$device' (surface-device --list)"
    dev_args="$(surface-device --lookup "$device" --args)"
    dev_name="$(surface-device --lookup "$device" --name)"
else
    dev_name="$(t 'unbekannt (ohne Devicetree)' 'unknown (no devicetree)')"
    warn "$(t 'Gerät nicht erkannt – es wird ohne Devicetree installiert. Auf einem Surface startet das System so nicht; in dem Fall mit --device ID neu aufrufen.' \
              'Device not detected – installing without a devicetree. On a Surface the system will not boot like this; rerun with --device ID in that case.')"
fi

msg "$(t 'Zusammenfassung' 'Summary')"
echo "    $(t 'Ziel:         ' 'Target:       ') $target  ($(findmnt -no SOURCE,FSTYPE "$target"))"
(( do_bootloader )) && echo "    $(t 'EFI-Partition:' 'EFI partition:') $esp  ($(findmnt -no SOURCE "$esp"))"
echo "    $(t 'Gerät:        ' 'Device:       ') $dev_name"
echo "    Devicetree:    ${dtb:-–}"
echo "    $(t 'Rechnername:  ' 'Host name:    ') $hostname"
echo "    $(t 'Sprache:      ' 'Language:     ') $(sed -n 's/^LANG=//p' /etc/locale.conf)"
echo "    $(t 'Tastatur:     ' 'Keyboard:     ') $(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf)"
ask "$(t 'Installation starten?' 'Start the installation?')" || exit 1

# --- Pakete ------------------------------------------------------------------
msg "$(t 'Bereite Initramfs-Konfiguration vor' 'Preparing the initramfs configuration')"
install -Dm644 "$SHARE/target/usr/lib/initcpio/install/surface-qcom" \
    "$target/usr/lib/initcpio/install/surface-qcom"

# linux-firmware-qcom gehört nicht zum Metapaket linux-firmware, enthält aber
# die GPU-/DSP-Firmware der Snapdragon-Plattformen – ohne sie bleibt nach dem
# Laden des Grafiktreibers das Bild stehen.
# vulkan-freedreno (Turnip): Mit Vulkan zeichnen GTK-4-Programme über Vulkan
# statt OpenGL. Unter OpenGL frieren die GNOME-Einstellungen nach der Seite
# "Maus und Tastfeld" ein und stürzen beim Schließen ab: Beim Beenden der
# Animationsvideos ruft GStreamer eglTerminate() für die EGL-Verbindung auf,
# die GTK mitbenutzt.
pkgs=(base linux-surface linux-firmware linux-firmware-qcom mkinitcpio grub efibootmgr
      archlinuxarm-keyring sudo nano networkmanager wireless-regdb terminus-font
      bluez bluez-utils alsa-ucm-conf alsa-utils openssh less which
      e2fsprogs dosfstools ntfs-3g cryptsetup vulkan-freedreno)
case "$(findmnt -no FSTYPE "$target")" in
    btrfs) pkgs+=(btrfs-progs) ;;
    xfs)   pkgs+=(xfsprogs) ;;
esac
if [[ "$device" == spx ]] && grep -q "^\[surface-local\]" /etc/pacman.conf; then
    pkgs+=(qrtr tqftpserv rmtfs-dummy-git)
fi
# Gerätespezifische Zusätze aus overlays.conf: Devicetree-Overlays (Touchpad,
# Touchscreen, ...) und Zusatzmodule (surface-kmods). Zum Neubauen der Module
# nach Kernel-Updates braucht das installierte System Header und Compiler.
overlays=""
needs_kmods=0
if [[ -n "$device" && -r "$SHARE/overlays.conf" ]]; then
    overlays="$(awk -F'|' -v id="$device" '$1 == id { print $2 }' "$SHARE/overlays.conf")"
    [[ "$(awk -F'|' -v id="$device" '$1 == id { print $3 }' "$SHARE/overlays.conf")" == yes ]] && needs_kmods=1
fi
pkgs+=(dtc)
# Kamera: libcamera (Software-ISP) und die PipeWire-Anbindung für Browser,
# Videotelefonie usw.
[[ " $overlays " == *" sl7-camera "* ]] && pkgs+=(libcamera libcamera-tools pipewire-libcamera)
# Kommt der Kernel aus dem Repository surface-kernel (vor [linux-surface]),
# enthält er die Zusatztreiber bereits; Header und Compiler sind dann nicht
# nötig.
own_kernel=0
grep -q '^\[surface-kernel\]' /etc/pacman.conf && own_kernel=1
(( needs_kmods && ! own_kernel )) && pkgs+=(linux-surface-headers base-devel git curl)
# iptsd verarbeitet die Rohdaten von Touchpad/Touchscreen. Es kommt aus dem
# Omarchy-Repository, das es bei Updates von fmt/spdlog neu baut; der
# Schlüsselbund dafür wird mitinstalliert (pacstrap übernimmt den Schlüssel aus
# dem Live-System).
if [[ -n "$overlays" ]] && grep -q "^\[omarchy\]" /etc/pacman.conf; then
    pkgs+=(omarchy-keyring iptsd)
fi
pkgs+=("${extra_pkgs[@]}")

msg "$(t 'Installiere Pakete (pacstrap)' 'Installing packages (pacstrap)')"
pacstrap "$target" "${pkgs[@]}"

# Das Preset des Kernelpakets ruft mkinitcpio mit ausdrücklicher Konfigurations-
# datei auf; Drop-ins unter mkinitcpio.conf.d werden dabei nicht gelesen. Die
# Hooks müssen deshalb in /etc/mkinitcpio.conf selbst stehen.
msg "$(t 'Trage Initramfs-Hooks ein' 'Registering the initramfs hooks')"
cat >> "$target/etc/mkinitcpio.conf" <<'EOF'

# --- added by surface-install -------------------------------------------------
# Deliberately without "autodetect": on Snapdragon-based Surface devices the
# display, keyboard and storage depend on many platform drivers that autodetect
# does not find reliably. The "surface-qcom" hook pulls them all in.
# For an encrypted root add "encrypt" before "filesystems".
HOOKS=(base udev modconf keyboard keymap consolefont block filesystems fsck surface-qcom)
EOF
cp /etc/vconsole.conf "$target/etc/vconsole.conf"
# Gebaut wird das Initramfs weiter unten, nach der Firmware-Übernahme: Die
# GPU-Firmware aus Windows muss mit hinein.

# Eigener Kernel mit den Treibern für den Laptop 7: vor [linux-surface], damit
# pacman linux-surface von dort nimmt.
if (( own_kernel )) && ! grep -q '^\[surface-kernel\]' "$target/etc/pacman.conf"; then
    kblock="$(printf '%s\n' \
        '# linux-surface with the Surface Laptop 7 drivers built in (https://git.3dns.eu/dom1nic/archlinux_arm64_surface)' \
        '[surface-kernel]' \
        "$(sed -n '/^\[surface-kernel\]/,/^$/{/^Server/p}' /etc/pacman.conf)")"
    if grep -q '^\[linux-surface\]' "$target/etc/pacman.conf"; then
        KB="$kblock" awk '/^\[linux-surface\]/ { print ENVIRON["KB"]; print "" } { print }' \
            "$target/etc/pacman.conf" > "$target/etc/pacman.conf.new"
        mv "$target/etc/pacman.conf.new" "$target/etc/pacman.conf"
    else
        printf '\n%s\n' "$kblock" >> "$target/etc/pacman.conf"
    fi
fi
if ! grep -q '^\[linux-surface\]' "$target/etc/pacman.conf"; then
    cat >> "$target/etc/pacman.conf" <<EOF

# Kernel for Snapdragon-based Surface devices (https://github.com/linux-surface)
[linux-surface]
$(sed -n '/^\[linux-surface\]/,/^$/{/^Server/p}' /etc/pacman.conf)
EOF
fi
# Omarchy als letztes Repository: Pakete, die es auch bei Arch Linux ARM gibt,
# kommen weiter von dort; aus Omarchy kommen nur iptsd und sein Schlüsselbund.
if [[ " ${pkgs[*]} " == *" iptsd "* ]] && ! grep -q '^\[omarchy\]' "$target/etc/pacman.conf"; then
    cat >> "$target/etc/pacman.conf" <<EOF

# Omarchy: iptsd with the patches for the Surface Laptop 7 (https://github.com/omacom/omarchy-pkgs)
[omarchy]
$(sed -n '/^\[omarchy\]/,/^$/{/^Server/p}' /etc/pacman.conf)
EOF
fi

# --- Grundkonfiguration ------------------------------------------------------
msg "$(t 'Schreibe Grundkonfiguration' 'Writing the base configuration')"
genfstab -U "$target" > "$target/etc/fstab"
echo "$hostname" > "$target/etc/hostname"
cp /etc/vconsole.conf /etc/locale.conf "$target/etc/"
cp /etc/locale.gen "$target/etc/locale.gen"
cp -P /etc/localtime "$target/etc/localtime"
ln -sf /run/systemd/resolve/stub-resolv.conf "$target/etc/resolv.conf"
arch-chroot "$target" locale-gen >/dev/null
# Netzwerk im installierten System: allein NetworkManager (Konsole: nmtui).
# iwd oder systemd-networkd daneben würden sich mit ihm um das WLAN streiten –
# die Passwortabfrage des Desktops bleibt dann aus.
arch-chroot "$target" systemctl enable NetworkManager.service systemd-resolved.service \
    systemd-timesyncd.service
if [[ "$device" == spx ]] && [[ -e "$target/usr/lib/systemd/system/rmtfs.service" ]]; then
    arch-chroot "$target" systemctl enable tqftpserv.service rmtfs.service
fi

# Werkzeuge auch im installierten System bereitstellen
install -Dm755 -t "$target/usr/local/bin" \
    /usr/local/bin/surface-device /usr/local/bin/surface-fw-extract /usr/local/bin/surface-locale
install -Dm644 -t "$target/usr/share/surface" "$SHARE/devices.conf" "$SHARE/i18n.sh"
install -Dm644 /etc/surface/lang "$target/etc/surface/lang"
install -Dm755 -t "$target/usr/local/bin" /usr/local/bin/surface-bt-addr \
    /usr/local/bin/surface-kmods /usr/local/bin/surface-dtb-update /usr/local/bin/surface-kernel-update
install -Dm644 -t "$target/etc/systemd/system" "$SHARE/target/etc/systemd/system/surface-bt-addr.service"
arch-chroot "$target" systemctl enable bluetooth.service surface-bt-addr.service
install -Dm644 "$SHARE/overlays.conf" "$target/usr/share/surface/overlays.conf"
cp -r "$SHARE/patches" "$SHARE/kmods" "$SHARE/overlays" "$target/usr/share/surface/"

if (( needs_kmods )); then
    msg "$(t 'Richte Zusatzmodule ein (WLAN, Touchpad, Touchscreen)' 'Setting up the extra modules (Wi-Fi, touchpad, touchscreen)')"
    for kdir in "$target"/usr/lib/modules/*/; do
        k="$(basename "$kdir")"
        if compgen -G "/usr/lib/modules/$k/updates/*.ko" >/dev/null; then
            # gleicher Kernel wie im Live-System: fertige Module übernehmen
            install -Dm644 -t "$kdir/updates" "/usr/lib/modules/$k"/updates/*.ko
            arch-chroot "$target" depmod "$k"
        else
            arch-chroot "$target" env SURFACE_KMODS_NO_INITRAMFS=1 surface-kmods --kernel "$k" \
                || warn "$(t 'Zusatzmodule nicht gebaut – später nachholen: surface-kmods' \
                             'Extra modules not built – catch up later: surface-kmods')"
        fi
    done
fi
if [[ " $overlays " == *" sl7-camera "* ]]; then
    # Kamera: Zugriff auf die dma-buf-Heaps für den Software-ISP von libcamera,
    # und die rohen CAMSS-Videoknoten in PipeWire ausblenden.
    install -Dm644 "$SHARE/target/etc/udev/rules.d/70-surface-dma-heap.rules" \
        "$target/etc/udev/rules.d/70-surface-dma-heap.rules"
    install -Dm644 "$SHARE/target/etc/wireplumber/wireplumber.conf.d/50-surface-camss.conf" \
        "$target/etc/wireplumber/wireplumber.conf.d/50-surface-camss.conf"
fi
if [[ " ${pkgs[*]} " == *" iptsd "* ]]; then
    # Touchpad/Touchscreen kommen nach dem Standby im Maus-Modus zurück; iptsd
    # muss neu starten, sobald spi_hid sie neu initialisiert hat. Der Dienst
    # aus dem iptsd-Paket (nur 15", feste 2 s) käme dafür zu früh.
    install -Dm755 /usr/local/bin/surface-touch-resume "$target/usr/local/bin/surface-touch-resume"
    install -Dm644 -t "$target/etc/systemd/system" \
        "$SHARE/target/etc/systemd/system/surface-touch-resume.service"
    arch-chroot "$target" systemctl enable surface-touch-resume.service
    arch-chroot "$target" systemctl mask iptsd-romulus15-resume.service
fi
if (( needs_kmods )) || [[ -n "$overlays" ]]; then
    install -Dm644 "$SHARE/target/etc/pacman.d/hooks/95-surface-kernel.hook" \
        "$target/etc/pacman.d/hooks/95-surface-kernel.hook"
fi

# --- Firmware ----------------------------------------------------------------
if [[ "$device" == spx && -d "$SHARE/firmware" ]]; then
    msg "$(t 'Kopiere Firmware für das Surface Pro X' 'Copying the firmware for the Surface Pro X')"
    cp -a "$SHARE/firmware/." "$target/usr/lib/firmware/"
fi
if (( do_firmware )) && [[ -d /sys/firmware/devicetree/base ]]; then
    msg "$(t 'Übernehme gerätespezifische Firmware aus Windows' 'Taking the device-specific firmware from Windows')"
    surface-fw-extract --root "$target" || \
        warn "$(t "Firmware unvollständig. Ohne sie fehlen z. B. GPU-Beschleunigung, Ton oder Akkuanzeige. Später nachholen mit: surface-fw-extract --root $target" \
                  "Firmware incomplete. Without it GPU acceleration, audio or the battery indicator are missing, for example. Catch up later with: surface-fw-extract --root $target")"
fi

msg "$(t 'Erzeuge Initramfs' 'Building the initramfs')"
arch-chroot "$target" mkinitcpio -P

# --- Bootloader --------------------------------------------------------------
msg "$(t 'Richte Bootkonfiguration ein' 'Setting up the boot configuration')"
# Kerne, die der Devicetree beschreibt, die der Chip aber nicht hat (Snapdragon
# X Plus mit 10 Kernen): Sie starten nicht ("CPU7: failed to boot") und werden
# aus dem Devicetree des installierten Systems entfernt.
cpus_absent=""
for c in /sys/devices/system/cpu/cpu[0-9]*; do
    n="${c##*cpu}"
    [[ "$(cat "$c/online" 2>/dev/null)" == 0 && -e "$c/of_node" ]] || continue
    journalctl -k -b --no-pager -o cat 2>/dev/null | grep -q "^CPU$n: failed to boot" || continue
    node="$(readlink -f "$c/of_node")"
    cpus_absent+="${cpus_absent:+ }${node##*/}"
done
[[ -n "$cpus_absent" ]] && msg "$(t 'Nicht vorhandene Kerne' 'Absent cores'): $cpus_absent"
cat > "$target/etc/default/surface-boot" <<EOF
# Written by surface-install; read by /etc/grub.d/09_surface.
# After changes run: grub-mkconfig -o /boot/grub/grub.cfg

# Devicetree of this device (file below /boot/dtb/linux-surface/qcom/)
SURFACE_DTB="$dtb"

# Kernel parameters this device needs
SURFACE_CMDLINE="clk_ignore_unused pd_ignore_unused systemd.tpm2_wait=0 cpufreq.default_governor=schedutil${dev_args:+ $dev_args}"

# Devicetree additions (names below /usr/share/surface/overlays). After changes
# run: surface-dtb-update && grub-mkconfig -o /boot/grub/grub.cfg
SURFACE_DTB_OVERLAYS="$overlays"

# Cores the devicetree describes but this chip lacks (e.g. the 10-core
# Snapdragon X Plus); surface-dtb-update removes them with their power domains.
SURFACE_DTB_CPUS_ABSENT="$cpus_absent"

# Rebuild the extra kernel modules (surface-kmods) after kernel updates
SURFACE_KMODS=$( (( needs_kmods )) && echo yes || echo no )
EOF
arch-chroot "$target" surface-dtb-update
install -Dm755 "$SHARE/target/etc/grub.d/09_surface" "$target/etc/grub.d/09_surface"
# Das Standardskript erzeugt Einträge ohne Devicetree – die würden nicht starten.
chmod -x "$target/etc/grub.d/10_linux"

if (( do_bootloader )); then
    msg "$(t 'Installiere GRUB' 'Installing GRUB')"
    nvram_ok=0
    if arch-chroot "$target" grub-install --target=arm64-efi \
            --efi-directory="$esp_in_target" --bootloader-id=arch --recheck; then
        if efibootmgr 2>/dev/null | grep -qi '\barch\b'; then
            nvram_ok=1
        fi
    else
        arch-chroot "$target" grub-install --target=arm64-efi \
            --efi-directory="$esp_in_target" --bootloader-id=arch --no-nvram --recheck
    fi

    if (( ! nvram_ok )); then
        fallback="$esp/EFI/BOOT/BOOTAA64.EFI"
        if [[ "$SURFACE_LANG" == en ]]; then
            warn "The UEFI boot entry could not be written (on these devices UEFI variables"
            warn "are not always writable from Linux)."
            echo "    GRUB is at $esp/EFI/arch/grubaa64.efi."
            echo "    So that the firmware finds it, it can additionally be placed as the"
            echo "    default bootloader ($fallback)."
            if [[ -e "$fallback" ]]; then
                echo "    The existing file is backed up as BOOTAA64.EFI.bak; Windows stays bootable"
                echo "    through its own entry (EFI/Microsoft/Boot/bootmgfw.efi)."
            fi
        else
            warn "Der UEFI-Booteintrag konnte nicht geschrieben werden (auf diesen Geräten sind"
            warn "UEFI-Variablen unter Linux nicht immer schreibbar)."
            echo "    GRUB liegt unter $esp/EFI/arch/grubaa64.efi."
            echo "    Damit die Firmware es findet, kann es zusätzlich als Standard-Bootloader"
            echo "    ($fallback) abgelegt werden."
            if [[ -e "$fallback" ]]; then
                echo "    Die vorhandene Datei wird als BOOTAA64.EFI.bak gesichert; Windows bleibt über"
                echo "    seinen eigenen Eintrag (EFI/Microsoft/Boot/bootmgfw.efi) startbar."
            fi
        fi
        if ask "$(t 'GRUB als Standard-Bootloader ablegen?' 'Place GRUB as the default bootloader?')"; then
            if [[ -e "$fallback" && ! -e "$fallback.bak" ]]; then
                cp "$fallback" "$fallback.bak"
            fi
            arch-chroot "$target" grub-install --target=arm64-efi \
                --efi-directory="$esp_in_target" --removable --no-nvram
        else
            warn "$(t 'Nicht abgelegt. Der Start muss dann von Hand eingerichtet werden.' \
                      'Not placed. Booting has to be set up by hand then.')"
        fi
    fi
fi

arch-chroot "$target" grub-mkconfig -o /boot/grub/grub.cfg

# --- Abschluss ---------------------------------------------------------------
if (( do_passwd )); then
    msg "$(t 'Passwort für root festlegen' 'Set the root password')"
    arch-chroot "$target" passwd \
        || warn "$(t 'Kein Passwort gesetzt – später nachholen:' 'No password set – catch up later:') arch-chroot $target passwd"
fi

msg "$(t 'Fertig' 'Done')"
if [[ "$SURFACE_LANG" == en ]]; then
    cat <<EOF
    Further setup (users, desktop, ...):  arch-chroot $target
    Then:  umount -R $target && reboot

    Notes:
      * Secure Boot has to stay disabled in the Surface UEFI settings.
      * Device/devicetree are in /etc/default/surface-boot.
      * The initramfs hooks are at the end of /etc/mkinitcpio.conf.
      * surface-fw-extract and surface-locale are available in the installed
        system as well.
      * Networking is handled by NetworkManager (console: nmtui).
EOF
else
    cat <<EOF
    Weitere Einrichtung (Benutzer, Desktop, ...):  arch-chroot $target
    Danach:  umount -R $target && reboot

    Hinweise:
      * Secure Boot muss in den Surface-UEFI-Einstellungen ausgeschaltet bleiben.
      * Gerät/Devicetree stehen in /etc/default/surface-boot.
      * Die Initramfs-Hooks stehen am Ende von /etc/mkinitcpio.conf.
      * surface-fw-extract und surface-locale gibt es auch im installierten
        System.
      * Das Netzwerk verwaltet NetworkManager (Konsole: nmtui).
EOF
fi
