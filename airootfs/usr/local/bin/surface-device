#!/bin/bash
# Erkennt das laufende Surface-Gerät anhand des Devicetrees und gibt die
# zugehörigen Angaben aus devices.conf aus.
# Detects the running Surface device from its devicetree and prints the
# matching data from devices.conf.

# shellcheck source=../../share/surface/i18n.sh
source /usr/share/surface/i18n.sh

CONF="${SURFACE_DEVICES_CONF:-/usr/share/surface/devices.conf}"

usage() {
    if [[ "$SURFACE_LANG" == en ]]; then
        cat <<'USAGE'
surface-device            readable summary
surface-device --id       only the device ID (e.g. sl7-13)
surface-device --name | --dtb | --args | --compatible
surface-device --list     all known devices
surface-device --lookup ID --dtb     data for a specific device
USAGE
    else
        cat <<'USAGE'
surface-device            lesbare Zusammenfassung
surface-device --id       nur die Geräte-ID (z. B. sl7-13)
surface-device --name | --dtb | --args | --compatible
surface-device --list     alle bekannten Geräte
surface-device --lookup ID --dtb     Angaben zu einem bestimmten Gerät
USAGE
    fi
}

lookup_id=""
field=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --id|--name|--dtb|--args|--compatible) field="${1#--}" ;;
        --lookup) lookup_id="$2"; shift ;;
        --list)
            grep -vE '^\s*(#|$)' "$CONF" | while IFS='|' read -r id name dtb _; do
                printf '%-10s %-40s %s\n' "$id" "$name" "$dtb"
            done
            exit 0 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "$(t 'Unbekannte Option' 'Unknown option'): $1" >&2; exit 2 ;;
    esac
    shift
done

machine_compat=()
if [[ -r /proc/device-tree/compatible ]]; then
    mapfile -d '' -t machine_compat < /proc/device-tree/compatible
fi

found=0
while IFS='|' read -r id name dtb args compat _; do
    [[ "$id" =~ ^[[:space:]]*(#|$) ]] && continue
    if [[ -n "$lookup_id" ]]; then
        [[ "$id" == "$lookup_id" ]] || continue
    else
        match=0
        for c in "${machine_compat[@]}"; do
            [[ "$c" == "$compat" ]] && match=1
        done
        (( match )) || continue
    fi
    found=1
    break
done < "$CONF"

if (( ! found )); then
    if [[ -z "$field" ]]; then
        if [[ ${#machine_compat[@]} -gt 0 ]]; then
            echo "$(t 'Unbekanntes Gerät (Devicetree:' 'Unknown device (devicetree:') ${machine_compat[*]})"
        else
            t 'Kein Devicetree vorhanden (ACPI-Boot, z. B. virtuelle Maschine)' \
              'No devicetree present (ACPI boot, e.g. a virtual machine)'
            echo
        fi
    fi
    exit 1
fi

case "$field" in
    id)         echo "$id" ;;
    name)       echo "$name" ;;
    dtb)        echo "$dtb" ;;
    args)       echo "$args" ;;
    compatible) echo "$compat" ;;
    *)
        echo "$(t 'Gerät:      ' 'Device:     ') $name ($id)"
        echo "Devicetree:  qcom/$dtb"
        echo "Kernel-Args: clk_ignore_unused pd_ignore_unused${args:+ $args}"
        ;;
esac
