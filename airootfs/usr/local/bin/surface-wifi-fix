#!/bin/bash
# Baut das WLAN-Modul ath12k mit einer Korrektur für den Surface Laptop 7 neu.
# Rebuilds the ath12k Wi-Fi module with a fix for the Surface Laptop 7.
#
# Hintergrund: Der rfkill-Eingang des WCN7850 meldet auf dem Laptop 7 dauerhaft
# "Funk aus"; ath12k sperrt das WLAN dann hart. Windows ignoriert den Pin über
# eine ACPI-Einstellung, die ein Devicetree-Start nicht sieht, und der
# linux-surface-Kernel kennt dafür (noch) keine Devicetree-Eigenschaft. Der
# Patch lässt ath12k die rfkill-Konfiguration auf diesen Geräten überspringen.
#
# Das Modul landet unter /usr/lib/modules/<Kernel>/updates/ und hat dort
# Vorrang vor dem Modul des Kernelpakets. Nach einem Kernel-Update muss es neu
# gebaut werden (der pacman-Hook 95-surface-wifi-fix.hook erledigt das).
set -euo pipefail

# shellcheck source=../../share/surface/i18n.sh
source /usr/share/surface/i18n.sh

PATCH=/usr/share/surface/patches/ath12k-sl7-rfkill.patch
KERNEL_REPO="https://github.com/linux-surface/kernel.git"
PKGBUILD_URL="https://raw.githubusercontent.com/linux-surface/aarch64-packages/linux_surface-%s/linux-surface/PKGBUILD"

usage() {
    if [[ "$SURFACE_LANG" == en ]]; then
        cat <<'USAGE'
Rebuilds the ath12k Wi-Fi module with the rfkill fix for the Surface Laptop 7
and installs it to /usr/lib/modules/<kernel>/updates/.

  surface-wifi-fix              for the running kernel
  surface-wifi-fix --all        for all installed kernels lacking the module
  surface-wifi-fix --kernel K   for kernel release K (e.g. 7.3.1-1-surface)
  surface-wifi-fix --force      rebuild even if the module is already there
  surface-wifi-fix --remove     remove the patched module(s) again

Needs: gcc make git patch curl and linux-surface-headers, plus network access.
USAGE
    else
        cat <<'USAGE'
Baut das WLAN-Modul ath12k mit der rfkill-Korrektur für den Surface Laptop 7
neu und installiert es nach /usr/lib/modules/<Kernel>/updates/.

  surface-wifi-fix              für den laufenden Kernel
  surface-wifi-fix --all        für alle installierten Kernel ohne das Modul
  surface-wifi-fix --kernel K   für die Kernel-Version K (z. B. 7.3.1-1-surface)
  surface-wifi-fix --force      auch bauen, wenn das Modul schon da ist
  surface-wifi-fix --remove     das gepatchte Modul wieder entfernen

Braucht: gcc make git patch curl und linux-surface-headers sowie Netzzugang.
USAGE
    fi
}

msg()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m %s\n' "$(t 'WARNUNG:' 'WARNING:')" "$*" >&2; }
die()  { printf '\033[1;31m%s\033[0m %s\n' "$(t 'FEHLER:' 'ERROR:')" "$*" >&2; exit 1; }

kernels=()
all=0
force=0
remove=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --all)     all=1 ;;
        --kernel)  kernels+=("$2"); shift ;;
        --force)   force=1 ;;
        --remove)  remove=1 ;;
        -h|--help) usage; exit 0 ;;
        *) die "$(t 'Unbekannte Option' 'Unknown option'): $1" ;;
    esac
    shift
done

(( EUID == 0 )) || die "$(t 'Bitte als root ausführen.' 'Please run as root.')"

if (( all )) || (( remove && ${#kernels[@]} == 0 )); then
    for d in /usr/lib/modules/*/; do
        [[ -e "$d/pkgbase" || -d "$d/build" ]] && kernels+=("$(basename "$d")")
    done
fi
[[ ${#kernels[@]} -gt 0 ]] || kernels=("$(uname -r)")

if (( remove )); then
    for k in "${kernels[@]}"; do
        if [[ -e "/usr/lib/modules/$k/updates/ath12k.ko" ]]; then
            rm -f "/usr/lib/modules/$k/updates/ath12k.ko"
            depmod "$k"
            msg "$k: $(t 'gepatchtes Modul entfernt' 'patched module removed')"
        fi
    done
    exit 0
fi

build_for() { # kernel-release
    local k="$1" moddir="/usr/lib/modules/$1" pkgver ref tmp src
    local out="$moddir/updates/ath12k.ko"

    if [[ -e "$out" ]] && (( ! force )); then
        msg "$k: $(t 'gepatchtes Modul ist schon vorhanden' 'patched module already present')"
        return 0
    fi
    [[ -d "$moddir/build" ]] || {
        warn "$k: $(t 'Kernel-Header fehlen (Paket linux-surface-headers).' 'kernel headers missing (package linux-surface-headers).')"
        return 1
    }
    local tool
    for tool in gcc make git patch curl; do
        command -v "$tool" >/dev/null || {
            warn "$(t 'Es fehlt' 'Missing'): $tool  (pacman -S --needed base-devel git curl)"
            return 1
        }
    done

    # Paketversion -> Kernel-Commit (steht im PKGBUILD des passenden Tags)
    pkgver="${k%-surface}"
    # shellcheck disable=SC2059
    ref="$(curl -fsSL --retry 3 "$(printf "$PKGBUILD_URL" "$pkgver")" \
            | sed -n 's/^_ref_ksource="\(.*\)"/\1/p')" || true
    [[ -n "$ref" ]] || {
        warn "$k: $(t 'Kernel-Quellstand nicht gefunden (kein Netz?).' 'kernel source revision not found (no network?).')"
        return 1
    }

    msg "$k: $(t 'hole ath12k-Quellen' 'fetching the ath12k sources') (${ref:0:12})"
    tmp="$(mktemp -d /var/tmp/surface-wifi-fix.XXXXXX)"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" RETURN
    git init -q "$tmp/k"
    git -C "$tmp/k" remote add origin "$KERNEL_REPO"
    git -C "$tmp/k" sparse-checkout set drivers/net/wireless/ath
    git -C "$tmp/k" fetch -q --depth 1 --filter=blob:none origin "$ref"
    git -C "$tmp/k" checkout -q FETCH_HEAD

    if grep -q 'disable-rfkill' "$tmp/k/drivers/net/wireless/ath/ath12k/"*.c; then
        msg "$k: $(t 'dieser Kernel kennt bereits "disable-rfkill" – Patch evtl. nicht mehr nötig' \
                    'this kernel already knows "disable-rfkill" – the patch may no longer be needed')"
    fi
    patch -s -d "$tmp/k" -p1 < "$PATCH" || {
        warn "$k: $(t 'Der Patch passt nicht mehr auf diesen Kernel.' 'The patch no longer applies to this kernel.')"
        return 1
    }

    msg "$k: $(t 'baue ath12k' 'building ath12k')"
    src="$tmp/k/drivers/net/wireless/ath/ath12k"
    make -s -j"$(nproc)" -C "$moddir/build" M="$src" modules >"$tmp/build.log" 2>&1 || {
        tail -n 20 "$tmp/build.log" >&2
        warn "$k: $(t 'Bauen fehlgeschlagen.' 'build failed.')"
        return 1
    }
    install -Dm644 "$src/ath12k.ko" "$out"
    depmod "$k"
    msg "$k: $(t 'installiert' 'installed'): $out"
}

rc=0
for k in "${kernels[@]}"; do
    build_for "$k" || rc=1
done

if (( rc )); then
    warn "$(t 'Ohne das gepatchte Modul bleibt das WLAN des Surface Laptop 7 unter dem betroffenen Kernel gesperrt. Vor dem Neustart beheben oder eine andere Netzverbindung bereithalten.' \
              'Without the patched module the Surface Laptop 7 Wi-Fi stays blocked under the affected kernel. Fix this before rebooting or keep another network connection at hand.')"
fi
exit "$rc"
