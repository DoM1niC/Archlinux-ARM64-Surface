#!/bin/bash
# Stellt Sprache und Tastaturbelegung ein / sets language and keyboard layout.
#
#   surface-locale                    aktuelle Einstellung anzeigen / show
#   surface-locale --lang en|de       Sprache / language
#   surface-locale --keymap us        Tastaturbelegung / keyboard layout
#   surface-locale --list-keymaps     verfügbare Belegungen / available layouts
#   surface-locale --boot             aus den Bootparametern übernehmen
#                                     (surface.lang=, surface.keymap=)
set -euo pipefail

# shellcheck source=../../share/surface/i18n.sh
source /usr/share/surface/i18n.sh

lang=""
keymap=""
from_boot=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -l|--lang)      lang="$2"; shift ;;
        -k|--keymap)    keymap="$2"; shift ;;
        --boot)         from_boot=1 ;;
        --list-keymaps) localectl list-keymaps; exit 0 ;;
        -h|--help)      sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "$(t 'Unbekannte Option' 'Unknown option'): $1" >&2; exit 2 ;;
    esac
    shift
done

if (( from_boot )); then
    for arg in $(< /proc/cmdline); do
        case "$arg" in
            surface.lang=*)   lang="${arg#*=}" ;;
            surface.keymap=*) keymap="${arg#*=}" ;;
        esac
    done
fi

if [[ -z "$lang" && -z "$keymap" ]]; then
    (( from_boot )) && exit 0
    echo "$(t 'Sprache' 'Language'):  $SURFACE_LANG"
    echo "$(t 'Tastatur' 'Keyboard'): $(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf 2>/dev/null)"
    exit 0
fi

(( EUID == 0 )) || { echo "$(t 'Bitte als root ausführen.' 'Please run as root.')" >&2; exit 1; }

if [[ -n "$lang" ]]; then
    case "$lang" in
        de) locale="de_DE.UTF-8" ;;
        en) locale="en_US.UTF-8" ;;
        *)  echo "$(t 'Unbekannte Sprache' 'Unknown language'): $lang (de, en)" >&2; exit 2 ;;
    esac
    install -d /etc/surface
    echo "$lang" > /etc/surface/lang
    echo "LANG=$locale" > /etc/locale.conf
    SURFACE_LANG="$lang"
fi

if [[ -n "$keymap" ]]; then
    if ! localectl list-keymaps 2>/dev/null | grep -qxF -- "$keymap"; then
        echo "$(t 'Unbekannte Tastaturbelegung' 'Unknown keyboard layout'): $keymap" >&2
        echo "$(t 'Liste' 'List'): surface-locale --list-keymaps" >&2
        exit 2
    fi
    # schlägt ohne virtuelle Konsole (z. B. nur seriell) fehl – unkritisch
    loadkeys "$keymap" 2>/dev/null || true
    touch /etc/vconsole.conf
    if grep -q '^KEYMAP=' /etc/vconsole.conf; then
        sed -i "s/^KEYMAP=.*/KEYMAP=$keymap/" /etc/vconsole.conf
    else
        echo "KEYMAP=$keymap" >> /etc/vconsole.conf
    fi
fi

if (( ! from_boot )); then
    echo "$(t 'Sprache' 'Language'):  $SURFACE_LANG"
    echo "$(t 'Tastatur' 'Keyboard'): $(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf)"
    [[ -n "$lang" ]] && echo "$(t 'Für Programme außerhalb der surface-Werkzeuge neu anmelden.' \
                                  'Log in again for programs other than the surface tools.')"
fi
exit 0
