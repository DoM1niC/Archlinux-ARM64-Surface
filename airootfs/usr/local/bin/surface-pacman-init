#!/bin/bash
# Erzeugt den pacman-Schlüsselbund des Live-Systems beim ersten Start.
set -e
pacman-key --init
# Userland: aarch64-Port von Arch Linux (archports) oder Arch Linux ARM
for kr in archports archlinuxarm; do
    [[ -e /usr/share/pacman/keyrings/$kr.gpg ]] && pacman-key --populate "$kr"
done
# Omarchy (iptsd), falls das Paket omarchy-keyring installiert ist
[[ -e /usr/share/pacman/keyrings/omarchy.gpg ]] && pacman-key --populate omarchy
pacman-key --add /usr/share/surface/surface.asc
pacman-key --lsign-key 56C464BAAC421453
# Eigener Kernel (Repository surface-kernel), falls das ISO damit gebaut wurde
if [[ -e /usr/share/surface/surface-kernel.asc && -e /usr/share/surface/surface-kernel.fpr ]]; then
    pacman-key --add /usr/share/surface/surface-kernel.asc
    pacman-key --lsign-key "$(cat /usr/share/surface/surface-kernel.fpr)"
fi
