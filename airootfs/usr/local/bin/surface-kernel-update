#!/bin/bash
# Wird nach Installation/Update des Kernels aufgerufen (pacman-Hook
# 95-surface-kernel.hook): baut Zusatzmodule und Devicetree neu.
# Run after the kernel is installed/updated: rebuilds the extra modules and
# the devicetree.
rc=0
/usr/local/bin/surface-dtb-update || rc=1

# Reste ersetzter Kernel entfernen: Im Modulordner eines alten Kernels bleiben
# nach dem Update nur die Zusatzmodule (updates/) und die Dateien von depmod.
# Remove leftovers of replaced kernels (only updates/ and depmod files remain).
for d in /usr/lib/modules/*-surface; do
    [[ -d "$d" && ! -e "$d/vmlinuz" ]] || continue
    [[ -z "$(find "$d" -mindepth 1 -maxdepth 1 ! -name updates ! -name 'modules.*' -print -quit)" ]] || continue
    rm -rf "$d"
done

# shellcheck disable=SC1091
[[ -r /etc/default/surface-boot ]] && source /etc/default/surface-boot
if [[ "${SURFACE_KMODS:-}" == yes ]]; then
    SURFACE_KMODS_NO_INITRAMFS=1 /usr/local/bin/surface-kmods --all || rc=1
    # die neuen Module gehören auch ins Initramfs
    mkinitcpio -P >/dev/null 2>&1 || rc=1
fi
exit "$rc"
