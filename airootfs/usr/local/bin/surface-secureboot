#!/bin/bash
# Secure Boot mit eigenen Schlüsseln für Snapdragon-Surface-Geräte.
# Secure Boot with your own keys for Snapdragon Surface devices.
#
# Unter Secure Boot sperrt GRUB den Befehl "devicetree", ohne den diese
# Geräte nicht starten. Deshalb startet das System dann über systemd-boot und
# ein signiertes UKI (Kernel, Initramfs, Devicetree, Kernel-Parameter in einer
# EFI-Datei, siehe surface-uki). Zwei Schritte mit Neustart dazwischen:
#
#   surface-secureboot boot     systemd-boot und UKI einrichten (Secure Boot
#                               noch aus); GRUB bleibt als Eintrag im Menü
#   surface-secureboot enroll   eigene Schlüssel und die von Microsoft (für
#                               Windows) eintragen, systemd-boot und UKI
#                               signieren; braucht den Setup Mode der Firmware
#   surface-secureboot status   Zustand anzeigen
#
# Setup Mode: im Surface-UEFI (Lauter-Taste + Ein/Aus) unter Sicherheit →
# Secure Boot "None" wählen. Dort lässt sich Secure Boot auch jederzeit wieder
# ausschalten, falls etwas nicht startet.
set -euo pipefail

# shellcheck source=../../share/surface/i18n.sh
source /usr/share/surface/i18n.sh

msg()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m %s\n' "$(t 'WARNUNG:' 'WARNING:')" "$*" >&2; }
die()  { printf '\033[1;31m%s\033[0m %s\n' "$(t 'FEHLER:' 'ERROR:')" "$*" >&2; exit 1; }

EFI_GLOBAL=8be4df61-93ca-11d2-aa0d-00e098032b8c
LOADER_GUID=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
CONF=/etc/default/surface-boot
SDBOOT_SRC=/usr/lib/systemd/boot/efi/systemd-bootaa64.efi

efivar_u8() { # name -> Wert des ersten Datenbytes
    local f="/sys/firmware/efi/efivars/$1-$EFI_GLOBAL"
    [[ -e "$f" ]] && od -An -t u1 -j4 -N1 "$f" | tr -d ' ' || echo "?"
}

conf_set() { # schlüssel wert
    if grep -q "^$1=" "$CONF"; then
        sed -i "s|^$1=.*|$1=\"$2\"|" "$CONF"
    else
        printf '\n%s="%s"\n' "$1" "$2" >> "$CONF"
    fi
}

find_esp() {
    local m
    for m in /efi /boot/efi /boot; do
        if mountpoint -q "$m" && [[ "$(findmnt -no FSTYPE "$m")" == vfat ]] && [[ -d "$m/EFI" ]]; then
            echo "$m"; return 0
        fi
    done
    return 1
}

booted_via_uki() {
    [[ -e /sys/firmware/efi/efivars/StubInfo-$LOADER_GUID ]]
}

status() {
    echo "Secure Boot:  $(efivar_u8 SecureBoot)   Setup Mode: $(efivar_u8 SetupMode)   (1 = $(t 'an' 'on'))"
    if [[ -e /sys/firmware/efi/efivars/LoaderInfo-$LOADER_GUID ]]; then
        echo "$(t 'Bootloader' 'Boot loader'):   $(tr -d '\0' < <(tail -c +5 "/sys/firmware/efi/efivars/LoaderInfo-$LOADER_GUID"))"
    else
        echo "$(t 'Bootloader' 'Boot loader'):   $(t 'nicht systemd-boot (GRUB?)' 'not systemd-boot (GRUB?)')"
    fi
    booted_via_uki && echo "UKI:          $(t 'gestartet über UKI' 'booted via UKI')"
    # shellcheck disable=SC1090
    [[ -r "$CONF" ]] && echo "SURFACE_BOOT: $(. "$CONF"; echo "${SURFACE_BOOT:-grub}")"
    command -v sbctl >/dev/null && sbctl status 2>/dev/null | sed 's/^/sbctl: /'
}

setup_boot() {
    (( EUID == 0 )) || die "$(t 'Bitte als root ausführen.' 'Please run as root.')"
    [[ -r "$CONF" ]] || die "$CONF $(t 'fehlt (mit surface-install installiert?)' 'missing (installed with surface-install?)')"
    local esp
    esp="$(find_esp)" || die "$(t 'EFI-Partition nicht gefunden (/efi, /boot/efi)' 'EFI system partition not found (/efi, /boot/efi)')"
    msg "$(t 'EFI-Partition' 'EFI system partition'): $esp"

    command -v ukify >/dev/null || pacman -S --needed --noconfirm systemd-ukify
    [[ -e "$SDBOOT_SRC" ]] || die "$SDBOOT_SRC $(t 'fehlt' 'missing')"

    # Kernel-Parameter ohne die gerätespezifischen (die hängt surface-uki an)
    if [[ ! -e /etc/kernel/cmdline ]]; then
        local root opts grubline=""
        root="root=UUID=$(findmnt -no UUID /) rw"
        opts="$(findmnt -no OPTIONS /)"
        [[ "$(findmnt -no FSTYPE /)" == btrfs && "$opts" == *subvol=* ]] \
            && root+=" rootflags=$(tr ',' '\n' <<< "$opts" | grep '^subvol=')"
        if [[ -r /etc/default/grub ]]; then
            # shellcheck disable=SC1091
            grubline="$(. /etc/default/grub; echo "${GRUB_CMDLINE_LINUX:-} ${GRUB_CMDLINE_LINUX_DEFAULT:-}")"
        fi
        echo "$root $grubline" | tr -s ' ' | sed 's/ $//' > /etc/kernel/cmdline
        msg "/etc/kernel/cmdline: $(cat /etc/kernel/cmdline)"
    fi

    conf_set SURFACE_ESP "$esp"
    conf_set SURFACE_BOOT uki

    # systemd-boot legt dort seinen Zufalls-Seed ab; nur root darf lesen
    if grep -qE "^[^#]+[[:space:]]$esp[[:space:]]+vfat[[:space:]].*fmask=0022" /etc/fstab; then
        sed -i -E "/[[:space:]]${esp//\//\\/}[[:space:]]+vfat[[:space:]]/ s/fmask=0022,dmask=0022/fmask=0077,dmask=0077/" /etc/fstab
        systemctl daemon-reload
        # vfat übernimmt fmask/dmask nur beim Einhängen, nicht per remount
        umount "$esp" && mount "$esp"
    fi

    msg "$(t 'Installiere systemd-boot' 'Installing systemd-boot')"
    local src="$SDBOOT_SRC"
    [[ -e "$SDBOOT_SRC.signed" ]] && src="$SDBOOT_SRC.signed"
    install -Dm644 "$src" "$esp/EFI/systemd/systemd-bootaa64.efi"
    install -d "$esp/loader/entries"
    [[ -e "$esp/loader/loader.conf" ]] || cat > "$esp/loader/loader.conf" <<EOF
# surface-secureboot
default arch-linux-surface.efi
timeout 3
console-mode keep
editor no
EOF
    # GRUB als Ausweich-Eintrag (startet nur ohne Secure Boot)
    if [[ -e "$esp/EFI/arch/grubaa64.efi" && ! -e "$esp/loader/entries/zz-grub.conf" ]]; then
        cat > "$esp/loader/entries/zz-grub.conf" <<'EOF'
title   GRUB (ohne Secure Boot / without Secure Boot)
efi     /EFI/arch/grubaa64.efi
EOF
    fi

    # UKI nach jedem mkinitcpio-Lauf neu bauen
    install -d /etc/initcpio/post
    cat > /etc/initcpio/post/surface-uki <<'EOF'
#!/bin/bash
# mkinitcpio ruft das nach jedem Image auf ($1 Kernel, $2 Initramfs); nur das
# Standard-Image von linux-surface geht ins UKI (surface-uki).
[[ "${2:-}" == /boot/initramfs-linux-surface.img ]] || exit 0
exec /usr/local/bin/surface-uki
EOF
    chmod 755 /etc/initcpio/post/surface-uki

    msg "$(t 'Baue das UKI' 'Building the UKI')"
    /usr/local/bin/surface-uki

    # Booteintrag vorn in der Bootreihenfolge
    if ! efibootmgr | grep -q 'Linux Boot Manager'; then
        local src_dev disk part
        src_dev="$(findmnt -no SOURCE "$esp")"
        disk="/dev/$(lsblk -no PKNAME "$src_dev")"
        part="$(cat "/sys/class/block/$(basename "$src_dev")/partition")"
        efibootmgr -q --create --disk "$disk" --part "$part" \
            --label "Linux Boot Manager" --loader '\EFI\systemd\systemd-bootaa64.efi'
    fi
    msg "$(t 'Fertig. Nach dem Neustart startet systemd-boot (3 s Menü: UKI, Windows, GRUB). Danach: surface-secureboot enroll' \
             'Done. After a reboot systemd-boot starts (3 s menu: UKI, Windows, GRUB). Then: surface-secureboot enroll')"
}

# Aussteller (CN) der Signatur einer EFI-Datei
efi_signer_ca() {
    python3 - "$1" <<'EOF'
import struct, subprocess, sys
d = open(sys.argv[1], "rb").read()
pe = struct.unpack_from("<I", d, 0x3c)[0]
dd = pe + 24 + (112 if struct.unpack_from("<H", d, pe + 24)[0] == 0x20b else 96)
off, size = struct.unpack_from("<II", d, dd + 4 * 8)
if not size:
    sys.exit(0)
r = subprocess.run(["openssl", "pkcs7", "-inform", "DER", "-print_certs", "-noout"],
                   input=d[off + 8:off + size], capture_output=True)
for line in r.stdout.decode().splitlines():
    if line.startswith("issuer=") and "Root" not in line:
        print(line.split("CN=")[-1].strip()); break
EOF
}

# CNs der Zertifikate in einer ESL-Datei
esl_cns() {
    python3 - "$1" <<'EOF'
import struct, subprocess, sys, uuid
X509 = uuid.UUID("a5c059a1-94e4-4aa7-87b5-ab155c2bf072")
d = open(sys.argv[1], "rb").read(); off = 0
while off + 28 <= len(d):
    t = uuid.UUID(bytes_le=d[off:off + 16]); lsize, hsize, ssize = struct.unpack("<III", d[off + 16:off + 28])
    if t == X509:
        body = d[off + 28 + hsize:off + lsize]
        for i in range(0, len(body), ssize):
            r = subprocess.run(["openssl", "x509", "-inform", "DER", "-noout", "-subject"],
                               input=body[i + 16:i + ssize], capture_output=True)
            print(r.stdout.decode().strip().split("CN=")[-1])
    off += lsize
EOF
}

enroll() {
    (( EUID == 0 )) || die "$(t 'Bitte als root ausführen.' 'Please run as root.')"
    # shellcheck disable=SC1090
    . "$CONF"
    [[ "${SURFACE_BOOT:-}" == uki ]] || die "$(t 'Zuerst: surface-secureboot boot' 'First run: surface-secureboot boot')"
    booted_via_uki || die "$(t 'Das System ist nicht über das UKI gestartet. Erst neu starten und prüfen, dass systemd-boot und das UKI funktionieren.' \
                               'The system did not boot via the UKI. Reboot first and check that systemd-boot and the UKI work.')"
    [[ "$(efivar_u8 SetupMode)" == 1 ]] || die "$(t 'Die Firmware ist nicht im Setup Mode (Surface-UEFI: Secure Boot "None").' \
                                                  'The firmware is not in setup mode (Surface UEFI: Secure Boot "None").')"
    command -v sbctl >/dev/null || pacman -S --needed --noconfirm sbctl

    sbctl status --json 2>/dev/null | grep -q '"installed": *true' || sbctl create-keys

    # Die Microsoft-Zertifikate müssen die CA enthalten, mit der Windows
    # signiert ist (beim Laptop 7: Windows UEFI CA 2023), sonst startet es
    # mit Secure Boot nicht mehr.
    local win="$SURFACE_ESP/EFI/Microsoft/Boot/bootmgfw.efi" tmp ca
    if [[ -e "$win" ]]; then
        ca="$(efi_signer_ca "$win")"
        tmp="$(mktemp -d)"
        ( cd "$tmp" && sbctl enroll-keys --microsoft --export esl >/dev/null )
        if ! esl_cns "$tmp/db.esl" | grep -qxF "$ca"; then
            rm -rf "$tmp"
            die "$(t "Windows ist mit \"$ca\" signiert, sbctl würde diese CA aber nicht eintragen – Windows startete mit Secure Boot nicht mehr. Abbruch." \
                     "Windows is signed with \"$ca\", but sbctl would not enroll that CA – Windows would no longer boot with Secure Boot. Aborting.")"
        fi
        rm -rf "$tmp"
        msg "$(t 'Windows-Signatur' 'Windows signature'): $ca – $(t 'wird mit eingetragen' 'will be enrolled')"
    fi

    msg "$(t 'Signiere systemd-boot und UKI' 'Signing systemd-boot and the UKI')"
    sbctl sign -s -o "$SDBOOT_SRC.signed" "$SDBOOT_SRC" >/dev/null
    install -Dm644 "$SDBOOT_SRC.signed" "$SURFACE_ESP/EFI/systemd/systemd-bootaa64.efi"
    sbctl sign -s "$SURFACE_ESP/EFI/systemd/systemd-bootaa64.efi" >/dev/null
    /usr/local/bin/surface-uki

    msg "$(t 'Trage die Schlüssel ein (eigene + Microsoft)' 'Enrolling the keys (own + Microsoft)')"
    sbctl enroll-keys --microsoft
    # nur die eigenen Dateien zeigen (Windows-Dateien sind von Microsoft signiert)
    sbctl verify 2>/dev/null | grep -E "EFI/(Linux|systemd)/|systemd-boot" || true
    msg "$(t 'Fertig. Nach dem Neustart ist Secure Boot aktiv (prüfen: surface-secureboot status). Startet etwas nicht: Surface-UEFI → Sicherheit → Secure Boot "None".' \
             'Done. After a reboot Secure Boot is active (check: surface-secureboot status). If something does not boot: Surface UEFI → Security → Secure Boot "None".')"
}

case "${1:-status}" in
    status) status ;;
    boot)   setup_boot ;;
    enroll) enroll ;;
    -h|--help|help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "$(t 'Unbekannter Befehl' 'Unknown command'): $1 (status | boot | enroll)" ;;
esac
