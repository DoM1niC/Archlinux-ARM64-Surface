#!/bin/bash
# Holt die gerätespezifische Firmware (DSP-, GPU-Firmware usw.) aus der
# Windows-Installation des Geräts.
#
# Diese Dateien sind von Microsoft/Qualcomm signiert, nicht frei verteilbar und
# deshalb nicht in linux-firmware enthalten. Welche Dateien gebraucht werden,
# steht im Devicetree des laufenden Kernels (firmware-name); gesucht wird im
# Treiberspeicher von Windows (Windows\System32\DriverStore\FileRepository).
set -uo pipefail

# shellcheck source=../../share/surface/i18n.sh
source /usr/share/surface/i18n.sh

usage() {
    if [[ "$SURFACE_LANG" == en ]]; then
        cat <<'USAGE'
Takes the device-specific firmware (DSP, GPU, ...) from the device's Windows
installation. Which files are needed is read from the running kernel's
devicetree; they are looked up in the Windows driver store.

Usage:
  surface-fw-extract [--root DIR] [--windows DIR|DEVICE] [--list]

  --root DIR       also copy into an installed system (e.g. /mnt)
  --windows X      mounted Windows drive or partition (otherwise searched for)
  --list           only show which files are needed / missing
USAGE
    else
        cat <<'USAGE'
Holt die gerätespezifische Firmware (DSP, GPU, ...) aus der Windows-
Installation des Geräts. Welche Dateien gebraucht werden, steht im Devicetree
des laufenden Kernels; gesucht wird im Treiberspeicher von Windows.

Aufruf:
  surface-fw-extract [--root VERZ] [--windows VERZ|GERÄT] [--list]

  --root VERZ      zusätzlich in ein installiertes System kopieren (z. B. /mnt)
  --windows X      eingehängtes Windows-Laufwerk oder Partition (sonst Suche)
  --list           nur anzeigen, welche Dateien gebraucht werden / fehlen
USAGE
    fi
}

roots=(/)
windows=""
list_only=0
mounted=()
mapper=""

msg()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m %s\n' "$(t 'WARNUNG:' 'WARNING:')" "$*" >&2; }
die()  { printf '\033[1;31m%s\033[0m %s\n' "$(t 'FEHLER:' 'ERROR:')" "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --root)    roots+=("${2%/}"); shift ;;
        --windows) windows="$2"; shift ;;
        --list)    list_only=1 ;;
        -h|--help) usage; exit 0 ;;
        *) die "$(t 'Unbekannte Option' 'Unknown option'): $1" ;;
    esac
    shift
done

cleanup() {
    local m
    for m in "${mounted[@]}"; do
        umount "$m" 2>/dev/null && rmdir "$m" 2>/dev/null
    done
    [[ -n "$mapper" ]] && cryptsetup close "$mapper" 2>/dev/null
}
trap cleanup EXIT

# --- benötigte Dateien aus dem Devicetree lesen ------------------------------
DT=/sys/firmware/devicetree/base
[[ -d "$DT" ]] || die "$(t 'Kein Devicetree vorhanden – läuft das System auf einem Surface?' \
                           'No devicetree present – is this system running on a Surface?')"

mapfile -t wanted < <(find "$DT" -name firmware-name -exec cat {} + 2>/dev/null \
                        | tr '\0' '\n' | grep -v '^$' | sort -u)
[[ ${#wanted[@]} -gt 0 ]] || die "$(t 'Der Devicetree nennt keine Firmware-Dateien.' \
                                      'The devicetree does not name any firmware files.')"

fw_present() { # root pfad
    local f="$1/usr/lib/firmware/$2"
    [[ -e "$f" || -e "$f.zst" || -e "$f.xz" ]]
}

missing=()
for f in "${wanted[@]}"; do
    need=0
    for r in "${roots[@]}"; do
        fw_present "$r" "$f" || need=1
    done
    if (( need )); then
        missing+=("$f")
        (( list_only )) && echo "$(t 'fehlt:    ' 'missing:  ') $f"
    else
        (( list_only )) && echo "$(t 'vorhanden:' 'present:  ') $f"
    fi
done
(( list_only )) && exit 0

if [[ ${#missing[@]} -eq 0 ]]; then
    msg "$(t 'Alle im Devicetree genannten Firmware-Dateien sind vorhanden.' \
             'All firmware files named in the devicetree are present.')"
    exit 0
fi

(( EUID == 0 )) || die "$(t 'Bitte als root ausführen.' 'Please run as root.')"

# --- Windows finden ----------------------------------------------------------
STORE_REL="Windows/System32/DriverStore/FileRepository"
store=""

try_mount() { # gerät -> setzt store bei Erfolg
    local dev="$1" mp
    mp="$(mktemp -d /run/surface-win.XXXXXX)"
    if mount -t ntfs3 -o ro,noatime "$dev" "$mp" 2>/dev/null \
       || mount -t ntfs-3g -o ro "$dev" "$mp" 2>/dev/null; then
        mounted+=("$mp")
        if [[ -d "$mp/$STORE_REL" ]]; then
            store="$mp/$STORE_REL"
            return 0
        fi
        umount "$mp"; rmdir "$mp"; unset 'mounted[-1]'
    else
        rmdir "$mp"
    fi
    return 1
}

open_bitlocker() { # gerät
    local dev="$1"
    echo
    msg "$dev $(t 'ist mit BitLocker verschlüsselt.' 'is encrypted with BitLocker.')"
    if [[ "$SURFACE_LANG" == en ]]; then
        echo "    You can find the 48-digit recovery key at"
        echo "    https://account.microsoft.com/devices/recoverykey"
        echo "    (Alternatively turn off device encryption in Windows.)"
    else
        echo "    Den 48-stelligen Wiederherstellungsschlüssel findest du unter"
        echo "    https://account.microsoft.com/devices/recoverykey"
        echo "    (Alternativ unter Windows die Geräteverschlüsselung abschalten.)"
    fi
    mapper="surface-win-$$"
    if cryptsetup open --type bitlk --readonly "$dev" "$mapper"; then
        try_mount "/dev/mapper/$mapper" && return 0
        cryptsetup close "$mapper"
    fi
    mapper=""
    return 1
}

if [[ -n "$windows" && -d "$windows" ]]; then
    [[ -d "$windows/$STORE_REL" ]] || die "$windows: $(t 'enthält kein' 'does not contain') $STORE_REL"
    store="$windows/$STORE_REL"
else
    msg "$(t 'Suche Windows-Partition...' 'Looking for the Windows partition...')"
    if [[ -n "$windows" ]]; then
        candidates=("$windows")
    else
        mapfile -t candidates < <(lsblk -rnpo PATH,FSTYPE | awk '$2=="ntfs" || $2=="BitLocker" {print $1}')
    fi
    for dev in "${candidates[@]}"; do
        fstype="$(lsblk -dno FSTYPE "$dev" 2>/dev/null)"
        if [[ "$fstype" == BitLocker ]]; then
            open_bitlocker "$dev" && break
        else
            try_mount "$dev" && break
        fi
    done
fi

if [[ -z "$store" ]]; then
    die "$(t 'Keine Windows-Installation gefunden. Mit --windows ein eingehängtes Windows-Laufwerk (oder ein entpacktes Wiederherstellungsabbild) angeben.' \
             'No Windows installation found. Use --windows to point to a mounted Windows drive (or an extracted recovery image).')"
fi
msg "$(t 'Windows-Treiberspeicher' 'Windows driver store'): $store"

# --- kopieren ----------------------------------------------------------------
copied=0
notfound=()
for f in "${missing[@]}"; do
    # neueste Fassung der Datei im Treiberspeicher nehmen
    src="$(find "$store" -type f -iname "$(basename "$f")" -printf '%T@\t%p\n' 2>/dev/null \
            | sort -rn | head -n1 | cut -f2-)"
    if [[ -z "$src" ]]; then
        notfound+=("$f")
        continue
    fi
    for r in "${roots[@]}"; do
        fw_present "$r" "$f" && continue
        install -Dm644 "$src" "$r/usr/lib/firmware/$f" \
            && echo "    $f  ->  ${r%/}/usr/lib/firmware/"
    done
    copied=$((copied + 1))
done

echo
msg "$copied $(t 'Datei(en) übernommen.' 'file(s) copied.')"
if [[ ${#notfound[@]} -gt 0 ]]; then
    warn "$(t 'Nicht im Windows-Treiberspeicher gefunden:' 'Not found in the Windows driver store:')"
    printf '    %s\n' "${notfound[@]}" >&2
    exit 3
fi
echo "    $(t 'Die Firmware wird beim nächsten Start geladen.' 'The firmware is loaded on the next boot.')"
