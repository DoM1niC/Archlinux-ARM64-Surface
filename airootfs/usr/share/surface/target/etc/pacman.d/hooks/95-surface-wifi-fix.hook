# Baut nach einem Kernel-Update das gepatchte ath12k-Modul für den
# Surface Laptop 7 neu (siehe surface-wifi-fix --help).
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux-surface
Target = linux-surface-headers

[Action]
Description = Rebuilding the patched ath12k module (Surface Laptop 7 Wi-Fi)...
When = PostTransaction
Exec = /usr/local/bin/surface-wifi-fix --all
