# Wandelt zstd-komprimierte Firmware in xz um; nur das kann der
# linux-surface-Kernel laden (siehe surface-firmware-xz). Läuft vor dem Hook
# von mkinitcpio (90-mkinitcpio-install.hook).
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/firmware/*

[Action]
Description = Converting firmware to xz for the linux-surface kernel...
When = PostTransaction
Exec = /usr/local/bin/surface-firmware-xz
