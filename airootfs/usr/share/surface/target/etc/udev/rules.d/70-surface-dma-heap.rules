# libcamera (Software-ISP) holt seine Ausgabepuffer aus einem dma-buf-Heap.
# Ohne diese Regel darf nur root darauf zugreifen; Kamera-Programme bekommen
# dann nur Rohdaten. Freigegeben wird bewusst nur der "system"-Heap (normaler
# Arbeitsspeicher): Den kleinen CMA-Bereich würde libcamera sonst bevorzugen
# und bei höheren Auflösungen nach wenigen Bildern erschöpfen.
SUBSYSTEM=="dma_heap", KERNEL=="system", GROUP="video", MODE="0660", TAG+="uaccess"
