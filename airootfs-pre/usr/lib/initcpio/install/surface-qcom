#!/bin/bash
# mkinitcpio-Hook: Treiber, die Snapdragon-Surface-Geräte schon im Initramfs
# brauchen, um Display, Tastatur und das Boot-Medium (USB/NVMe/UFS) zu
# erreichen. Auf diesen Plattformen hängt fast jedes Gerät an Takt-, Regler-,
# PHY- und Interconnect-Treibern; fehlt einer davon, bleibt der Start beim
# Warten auf das Root-Dateisystem stehen. Deshalb wird bewusst großzügig
# eingesammelt statt per autodetect.

build() {
    local dir
    local -a dirs=(
        # SoC-Grundlagen
        clk/qcom pinctrl/qcom soc/qcom interconnect/qcom firmware/qcom
        regulator mfd spmi nvmem reset mailbox rpmsg power/reset
        iommu cpufreq pmdomain/qcom irqchip dma/qcom hwspinlock bus
        # Busse
        i2c/busses spi tty/serial/qcom_geni_serial pwm
        # Speicher
        nvme pci/controller pci/pwrctrl power/sequencing ufs mmc/host phy/qualcomm phy
        # USB / Type-C
        usb/dwc3 usb/host usb/typec usb/common usb/roles usb/misc usb/storage
        soc/qcom/pmic_glink
        # Anzeige
        gpu/drm/msm gpu/drm/panel gpu/drm/bridge gpu/drm/display video/backlight leds
        # Eingabe (Surface Aggregator, HID)
        platform/surface hid input/keyboard input/misc
        # Akku / Ladezustand
        power/supply
    )

    for dir in "${dirs[@]}"; do
        add_all_modules "/drivers/${dir}/"
    done

    # Bewusst NICHT im Initramfs: drivers/remoteproc (ADSP/CDSP). Deren Firmware
    # liegt nur im Root-Dateisystem; würde der Treiber schon hier geladen,
    # schlüge das Laden fehl und würde später nicht wiederholt – ohne ADSP
    # fehlen Akkuanzeige, USB-C-Erkennung und Ton.

    # Der Grafiktreiber (msm) wird dagegen früh geladen und braucht die
    # Adreno-Firmware; mkinitcpio findet sie nicht von selbst.
    local fw fwdir=/usr/lib/firmware
    for fw in "$fwdir"/qcom/gen[0-9]*_sqe.fw* "$fwdir"/qcom/gen[0-9]*_gmu.bin* \
              "$fwdir"/qcom/a[67][0-9][0-9]_sqe.fw* "$fwdir"/qcom/a[67][0-9][0-9]_gmu.bin*; do
        [[ -e "$fw" ]] || continue
        fw="${fw#"$fwdir"/}"
        add_firmware "${fw%.zst}"
    done
    # ... sowie die gerätespezifische GPU-Firmware (zap shader), die der
    # Devicetree des laufenden Systems nennt – sofern sie schon vorhanden ist.
    if [[ -d /sys/firmware/devicetree/base ]]; then
        while IFS= read -r fw; do
            [[ "$fw" == *dxkms* || "$fw" == *zap* ]] || continue
            [[ -e "$fwdir/$fw" || -e "$fwdir/$fw.zst" ]] && add_firmware "$fw"
        done < <(find /sys/firmware/devicetree/base -name firmware-name -exec cat {} + 2>/dev/null | tr '\0' '\n')
    fi
}

help() {
    cat <<HELPEOF
Nimmt die Plattformtreiber für Qualcomm-Snapdragon-basierte Surface-Geräte
(SC8180X, SC8280XP, X1E80100/X1P) in das Initramfs auf.
HELPEOF
}
